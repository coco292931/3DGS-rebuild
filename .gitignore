# ---- 训练数据：体积大，可由脚本重新生成 ----
data/

# ---- 训练中间产物：checkpoint / 预览 / 日志，不进仓库 ----
output/*/
# 但交付成品要留（PLY 模型无法由脚本重新生成，必须提交）
!output/deliverable/
!output/deliverable_real/

# ---- Python ----
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
Thumbs.db
desktop.ini
*.swp