# ---- 训练数据：体积大，可由脚本重新生成 ----
data/

# ---- 训练中间产物：checkpoint / 预览 / 日志，不进仓库 ----
output/*/
# 但交付成品要留（PLY 模型无法由脚本重新生成，必须提交）
!output/deliverable/
!output/deliverable_real/

# ---- 官方 CUDA 扩展：源码与编译产物都不进仓库 ----
# 用 _upstream/build_dgr.bat 自行拉取并编译即可
_upstream/diff-gaussian-rasterization-main/
_upstream/glm-master/
_upstream/_ext/
_upstream/*.tar.gz
# 但保留与官方实现对比的验证脚本（记录了如何做基准对照）
!_upstream/compare_official.py
_upstream/debug_grad*.py
_upstream/debug_pixels.py
_upstream/debug_opacity.py
_upstream/debug_scale.py
_upstream/debug_train_step.py
_upstream/diagnose_backend.py
_upstream/diagnose_densify.py
_upstream/test_official.py
_upstream/graphics_utils.py
_upstream/general_utils.py
_upstream/sh_utils.py

# ---- Python ----
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# ---- 提交信息临时文件 ----
# 用 git commit -F 传多行中文提交信息时落盘的中间文件。
# 之前忘了忽略它，导致每次提交都把它一起带上，然后再补一个「移除临时文件」的
# 无用提交——历史里攒了九条这种垃圾。
_cmsg*.txt
_commitmsg.txt
*.commitmsg

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
Thumbs.db
desktop.ini
*.swp
